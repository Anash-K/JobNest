# Copy to .env and fill in values: cp .env.example .env

# Neon PostgreSQL (recommended — pooled connection, SSL required)
# Create a project at https://neon.tech and copy the pooled connection string.
# Example format (replace with your credentials):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Better Auth (required)
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# Global Google OAuth (required at startup — IMPLEMENTATION.md §9)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/gmail/callback

# AES-256-GCM key — 32 bytes as 64-char hex (generate: openssl rand -hex 32)
ENCRYPTION_KEY=

# File uploads
MAX_RESUME_SIZE_MB=4

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUME_BUCKET=jobnest-resumes

# Bulk send defaults
BULK_SEND_DELAY_SECONDS=25
BULK_SEND_MAX_RETRIES=3
BULK_SEND_DAILY_WARN_THRESHOLD=400

# ── Optional: local PostgreSQL (legacy) ──────────────────────────────────────
# DATABASE_URL=postgresql://jobhunter:jobhunter@localhost:5432/jobhunter
