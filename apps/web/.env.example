# Copy for local development:
#   cp .env.example .env
# or (Next.js override, also gitignored):
#   cp .env.example .env.local
#
# Next.js loads .env and .env.local automatically (.env.local overrides .env).
# Only NEXT_PUBLIC_* vars are exposed to the browser.

# Express API base URL (includes /api/v1 prefix)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Better Auth server origin (no path — auth client uses /api/v1/auth)
NEXT_PUBLIC_AUTH_URL=http://localhost:4000

# ── Production example ───────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
# NEXT_PUBLIC_AUTH_URL=https://api.yourdomain.com
